---
apiVersion: "{{ keycloak_foundation_api_group }}/{{ keycloak_foundation_cr_version_selected }}"
kind: Keycloak
metadata:
  name: "{{ keycloak_foundation_name }}"
  namespace: "{{ keycloak_foundation_namespace }}"
spec:
  instances: {{ keycloak_foundation_instances }}
  unsupported:
    podTemplate:
      spec:
        serviceAccountName: "{{ keycloak_foundation_service_account_name }}"
        securityContext:
          runAsNonRoot: true
          seccompProfile:
            type: RuntimeDefault
{% if keycloak_foundation_theme_configmap or keycloak_foundation_naver_spi_configmap %}
        # ConfigMap 마운트(커스텀 이미지 불필요):
        # - cledyu 테마 → /opt/keycloak/themes/cledyu
        # - 네이버 SPI JAR → /opt/keycloak/providers/naver-idp.jar (subPath, 기존 provider 보존)
        containers:
          - name: keycloak
            volumeMounts:
{% if keycloak_foundation_theme_configmap %}
              - name: cledyu-theme
                mountPath: /opt/keycloak/themes/cledyu
                readOnly: true
{% endif %}
{% if keycloak_foundation_naver_spi_configmap %}
              - name: naver-spi
                mountPath: /opt/keycloak/providers/naver-idp.jar
                subPath: naver-idp.jar
                readOnly: true
{% endif %}
        volumes:
{% if keycloak_foundation_theme_configmap %}
          - name: cledyu-theme
            configMap:
              name: "{{ keycloak_foundation_theme_configmap }}"
              items:
                - key: theme.properties
                  path: login/theme.properties
                - key: cledyu.css
                  path: login/resources/css/cledyu.css
                - key: messages_ko.properties
                  path: login/messages/messages_ko.properties
{% endif %}
{% if keycloak_foundation_naver_spi_configmap %}
          - name: naver-spi
            configMap:
              name: "{{ keycloak_foundation_naver_spi_configmap }}"
{% endif %}
{% endif %}
  db:
    vendor: postgres
    host: "{{ keycloak_foundation_db_service_name }}"
    usernameSecret:
      name: "{{ keycloak_foundation_db_secret_name }}"
      key: username
    passwordSecret:
      name: "{{ keycloak_foundation_db_secret_name }}"
      key: password
  http:
    httpEnabled: true
  ingress:
    enabled: false
  proxy:
    headers: xforwarded
  hostname:
{% if keycloak_foundation_hostname %}
    hostname: "{{ keycloak_foundation_hostname }}"
{% endif %}
    strict: {{ keycloak_foundation_hostname_strict | bool | lower }}
