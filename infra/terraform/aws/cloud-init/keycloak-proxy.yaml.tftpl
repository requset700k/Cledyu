#cloud-config
# Cledyu Keycloak tailnet 리버스프록시 cloud-init.
#
# 역할: ALB(443, ACM TLS 종단)에서 들어온 평문 HTTP 를 받아 tailnet 너머의 Keycloak
# (upstream_url)으로 포워딩한다. Host 를 공개 FQDN(public_host)으로 보존하고
# X-Forwarded-Proto=https 를 세팅해, Keycloak(proxy.headers=xforwarded, strict=false)이
# 공개 도메인 기준으로 issuer·broker·콜백 URL 을 생성하게 한다.
#
# 주의: tailscale authkey 는 user-data(IMDSv2)로 주입된다 — 기존 세션 인스턴스 패턴과 동일.
# 운영에서는 만료 짧은 ephemeral/재사용 키 권장.

package_update: true
packages:
  - curl
  - debian-keyring
  - debian-archive-keyring
  - apt-transport-https

write_files:
  - path: /etc/caddy/Caddyfile
    permissions: "0644"
    content: |
      # ALB→프록시 hop 은 평문 :80. 공개 TLS 는 ALB(ACM)가 종단한다.
      :80 {
        reverse_proxy ${upstream_url} {
          header_up Host ${public_host}
          header_up X-Forwarded-Host ${public_host}
          header_up X-Forwarded-Proto https
        }
        # ALB 헬스체크(/realms/cledyu-learn)는 위 reverse_proxy 로 그대로 흘러간다.
      }

runcmd:
  # 호스트네임(태그와 정렬, tailnet 식별 용이).
  - hostnamectl set-hostname ${hostname} || true
  # Tailscale 설치 + tailnet 가입(authkey 주입). 광고 없이 클라이언트로만 참여.
  - curl -fsSL https://tailscale.com/install.sh | sh
  - tailscale up --authkey "${tailscale_auth_key}" --hostname "${hostname}" --ssh || true
  # Caddy 설치(공식 apt 저장소).
  - curl -1sLf 'https://dl.cloudsmith.io/public/caddy/stable/gpg.key' | gpg --dearmor -o /usr/share/keyrings/caddy-stable-archive-keyring.gpg
  - curl -1sLf 'https://dl.cloudsmith.io/public/caddy/stable/debian.deb.txt' | tee /etc/apt/sources.list.d/caddy-stable.list
  - apt-get update -y
  - apt-get install -y caddy
  - systemctl enable --now caddy
  - systemctl reload caddy || systemctl restart caddy
