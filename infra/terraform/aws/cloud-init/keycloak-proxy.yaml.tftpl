#cloud-config
# Cledyu 리버스프록시 cloud-init.
#
# 역할: ALB(443, ACM TLS 종단)에서 들어온 평문 HTTP 를 받아 tailnet 너머의 Traefik LB
# (upstream_url)으로 포워딩한다. 공개 Host(app|api|auth.cledyu.com)를 그대로 보존해
# 넘기고 X-Forwarded-Proto=https 를 세팅한다 — Traefik 이 Host 기준으로 ingress 를
# 라우팅하고, Keycloak(proxy.headers=xforwarded, strict=false)은 공개 도메인 기준으로
# issuer·broker·콜백 URL 을 생성한다.
#
# 주의: tailscale authkey 는 user-data(IMDSv2)로 주입된다 — 기존 세션 인스턴스 패턴과 동일.
# 운영에서는 만료 짧은 ephemeral/재사용 키 권장.

package_update: true
packages:
  - curl
  - debian-keyring
  - debian-archive-keyring
  - apt-transport-https

write_files:
  - path: /etc/caddy/Caddyfile
    permissions: "0644"
    content: |
      # ALB→프록시 hop 은 평문 :80. 공개 TLS 는 ALB(ACM)가 종단한다.
      # 공개 Host(app|api|auth.cledyu.com)를 그대로 보존해 tailnet 너머 Traefik LB
      # (${upstream_url})로 전달한다. ALB 는 원본 Host 를 타겟까지 넘긴다. 다만 Caddy 는
      # HTTPS upstream(v2.11+)에서 Host 를 upstream 주소로 자동 설정하므로, 반드시
      # header_up Host {http.request.host} 로 원본 공개 Host 를 명시 전달해야 Traefik 이
      # 호스트 rule 로 라우팅한다(미명시 시 Host=10.10.0.101 → ingress 미매칭, 그런데
      # /healthz 는 Caddy 가 직접 200 이라 ALB 는 healthy 로 보이는 silent 실패).
      :80 {
        # ALB 헬스체크 전용 — 프록시 생존만 판정(Traefik/업스트림 상태와 분리).
        handle /healthz {
          respond "ok" 200
        }

        handle {
          reverse_proxy ${upstream_url} {
            header_up Host {http.request.host}
            header_up X-Forwarded-Host {http.request.host}
            header_up X-Forwarded-Proto https
%{ if upstream_tls ~}
            # Traefik(내부 CA) HTTPS upstream 전용 — tailnet(WireGuard) 암호화 hop 이라
            # 인증서 검증은 생략한다. tls_* 옵션은 upstream 스킴과 무관하게 TLS 를 켜므로
            # http upstream 일 때는 이 블록을 렌더하지 않는다(평문 upstream 502 방지).
            transport http {
              tls_insecure_skip_verify
            }
%{ endif ~}
          }
        }
      }

runcmd:
  # 호스트네임(태그와 정렬, tailnet 식별 용이).
  - hostnamectl set-hostname ${hostname} || true
  # Tailscale 설치 + tailnet 가입(authkey 주입). --accept-routes 필수 —
  # 하이퍼바이저 subnet router 가 광고한 10.10.0.0/24(Traefik LB 포함) 라우트를
  # 받아야 Keycloak 에 닿는다. 광고는 하지 않고 클라이언트로만 참여.
  - curl -fsSL https://tailscale.com/install.sh | sh
  - tailscale up --authkey "${tailscale_auth_key}" --hostname "${hostname}" --accept-routes --ssh || true
  # Caddy 설치(공식 apt 저장소).
  # write_files 가 패키지 설치 전에 /etc/caddy/Caddyfile 을 써두므로, 패키지의 conffile
  # 과 충돌해 dpkg 가 대화형 프롬프트(keep/replace)를 띄운다. 비대화형 cloud-init 에선
  # EOF→configure 실패→caddy user 미생성→서비스 사망(217/USER)으로 이어진다. 따라서
  # --force-confold 로 우리 Caddyfile 을 유지하며 프롬프트 없이 configure 를 완주시킨다.
  - curl -1sLf 'https://dl.cloudsmith.io/public/caddy/stable/gpg.key' | gpg --dearmor -o /usr/share/keyrings/caddy-stable-archive-keyring.gpg
  - curl -1sLf 'https://dl.cloudsmith.io/public/caddy/stable/debian.deb.txt' | tee /etc/apt/sources.list.d/caddy-stable.list
  - apt-get update -y
  - DEBIAN_FRONTEND=noninteractive apt-get install -y -o Dpkg::Options::=--force-confold caddy
  - systemctl enable --now caddy
  - systemctl reload caddy || systemctl restart caddy
