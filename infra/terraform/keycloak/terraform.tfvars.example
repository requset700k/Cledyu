keycloak_admin_username = "temp-admin"
keycloak_admin_password = "REPLACE_WITH_1PASSWORD_VALUE"

# 운영자(내부) realm 클라이언트만. 학습자 앱(web/api/tutor)은 learn_oidc_clients 참조.
oidc_clients = {
  argocd = {
    name                            = "Cledyu ArgoCD"
    access_type                     = "CONFIDENTIAL"
    standard_flow_enabled           = true
    direct_access_grants_enabled    = false
    implicit_flow_enabled           = false
    service_accounts_enabled        = false
    valid_redirect_uris             = ["https://argocd.cledyu.local/auth/callback"]
    valid_post_logout_redirect_uris = ["https://argocd.cledyu.local/"]
    web_origins                     = ["https://argocd.cledyu.local"]
  }

  grafana = {
    name                            = "Cledyu Grafana"
    access_type                     = "CONFIDENTIAL"
    standard_flow_enabled           = true
    direct_access_grants_enabled    = false
    implicit_flow_enabled           = false
    service_accounts_enabled        = false
    valid_redirect_uris             = ["https://grafana.cledyu.local/login/generic_oauth"]
    valid_post_logout_redirect_uris = ["https://grafana.cledyu.local/"]
    web_origins                     = ["https://grafana.cledyu.local"]
  }

  vault = {
    name                            = "Cledyu Vault"
    access_type                     = "CONFIDENTIAL"
    standard_flow_enabled           = true
    direct_access_grants_enabled    = false
    implicit_flow_enabled           = false
    service_accounts_enabled        = false
    valid_redirect_uris             = ["http://localhost:8250/oidc/callback", "https://vault.cledyu.local/ui/vault/auth/oidc/oidc/callback"]
    valid_post_logout_redirect_uris = ["https://vault.cledyu.local/"]
    web_origins                     = ["https://vault.cledyu.local"]
  }

  kubectl = {
    name                         = "Cledyu kubectl (oidc-login)"
    access_type                  = "PUBLIC"
    standard_flow_enabled        = true
    direct_access_grants_enabled = false
    implicit_flow_enabled        = false
    service_accounts_enabled     = false
    pkce_code_challenge_method   = "S256"
    valid_redirect_uris = [
      "http://localhost:8000",
      "http://localhost:18000",
      "http://127.0.0.1:8000",
      "http://127.0.0.1:18000",
    ]
  }

  airflow = {
    name                            = "Cledyu Airflow"
    access_type                     = "CONFIDENTIAL"
    standard_flow_enabled           = true
    direct_access_grants_enabled    = false
    implicit_flow_enabled           = false
    service_accounts_enabled        = false
    valid_redirect_uris             = ["https://airflow.cledyu.local/oauth-authorized/keycloak"]
    valid_post_logout_redirect_uris = ["https://airflow.cledyu.local/"]
    web_origins                     = ["https://airflow.cledyu.local"]
  }
}

oidc_client_secrets = {
  argocd  = "REPLACE_WITH_ARGOCD_CLIENT_SECRET"
  grafana = "REPLACE_WITH_GRAFANA_CLIENT_SECRET"
  vault   = "REPLACE_WITH_VAULT_CLIENT_SECRET"
  airflow = "REPLACE_WITH_AIRFLOW_CLIENT_SECRET"
}

# ─────────────────────────────────────────────────────────────────────────
# cledyu-learn realm — 외부 학습자 자가가입 + 소셜 로그인 (운영자 realm과 분리)
# ─────────────────────────────────────────────────────────────────────────

# 학습자 앱 클라이언트. web 은 백엔드 BFF(code 교환 대행)라 confidential.
learn_oidc_clients = {
  web = {
    name                            = "Cledyu Web"
    access_type                     = "CONFIDENTIAL"
    standard_flow_enabled           = true
    direct_access_grants_enabled    = false
    implicit_flow_enabled           = false
    service_accounts_enabled        = false
    pkce_code_challenge_method      = "S256"
    valid_redirect_uris             = ["https://api.cledyu.local/api/v1/auth/callback"]
    valid_post_logout_redirect_uris = ["https://app.cledyu.local/"]
    web_origins                     = ["https://app.cledyu.local"]
    root_url                        = "https://app.cledyu.local"
    base_url                        = "/"
  }

  api = {
    name                         = "Cledyu API"
    access_type                  = "BEARER-ONLY"
    standard_flow_enabled        = false
    direct_access_grants_enabled = false
    implicit_flow_enabled        = false
    service_accounts_enabled     = false
  }

  tutor = {
    name                         = "Cledyu Tutor API"
    access_type                  = "BEARER-ONLY"
    standard_flow_enabled        = false
    direct_access_grants_enabled = false
    implicit_flow_enabled        = false
    service_accounts_enabled     = false
  }

  # 역할 승격(instructor/admin) service-account client. api 가 이 자격으로 Keycloak Admin
  # REST API 를 호출한다. realm-management 역할(manage-users, view-realm)은 clients-learn-admin.tf
  # 가 자동 부여한다. client_secret 은 learn_oidc_client_secrets 로 주입 + Vault 에 동일 값 시드.
  cledyu-admin = {
    name                         = "Cledyu Admin (role promotion service account)"
    access_type                  = "CONFIDENTIAL"
    standard_flow_enabled        = false
    direct_access_grants_enabled = false
    implicit_flow_enabled        = false
    service_accounts_enabled     = true
  }
}

# secret 실제 값은 git 에 두지 말 것 — apply 시 -var 로 주입한다(tfvars 값이 -var 보다 우선이라
# placeholder 를 두면 주입 값을 덮어쓴다). cledyu-admin 은 생성한 secret 을 Vault
# cledyu/oidc/cledyu-admin 에도 동일하게 시드해야 ESO 가 api 로 주입한다.
learn_oidc_client_secrets = {
  web          = "REPLACE_WITH_WEB_CLIENT_SECRET"
  cledyu-admin = "REPLACE_WITH_CLEDYU_ADMIN_CLIENT_SECRET"
}

# 소셜 IdP 단계적 게이트. 개발자 콘솔에서 client 발급된 provider 만 넣는다.
# 구글 OAuth 발급 + auth.cledyu.com 공개 노출 완료 후 ["google"], 이후 카카오/네이버 추가.
# 빈 목록이면 IdP 미생성. (google/kakao/naver 만 허용)
enabled_social_idps = []

# 이메일 인증. learn_smtp 설정 후 true 로(아래 Brevo 블록 채우고 켤 것).
learn_verify_email = true

# 학습자 realm SMTP — verify_email / 비번재설정 메일 발송용. (Brevo SMTP 릴레이)
#   host/port 는 고정. auth_username = Brevo 계정 이메일(또는 대시보드 SMTP 로그인).
#   from = Brevo 에서 인증(verify)한 발신 주소여야 메일이 나간다.
#   비밀번호(SMTP key)는 절대 git 에 두지 말 것 — 아래 learn_smtp_password 는
#   환경변수 TF_VAR_learn_smtp_password 로 주입하거나 보안 tfvars(gitignored)에만.
learn_smtp = {
  host          = "smtp-relay.brevo.com"
  port          = "587"
  from          = "no-reply@cledyu.com"  # ← Brevo 에서 verify 한 발신 주소로 교체
  auth_username = "REPLACE_WITH_BREVO_LOGIN_EMAIL"
  starttls      = true
  ssl           = false
}
# learn_smtp_password(Brevo SMTP key)도 여기 두지 말 것 — tfvars 값이 TF_VAR 보다
# 우선이라 placeholder 가 SM 값을 덮어쓴다(idp_client_secrets 와 동일 함정). apply 시
# GCP Secret Manager 에서 주입: TF_VAR_learn_smtp_password="$(gcloud secrets versions
# access latest --secret=cledyu-learn-smtp-key --project=cledyu-project)"
# (learn_smtp 블록을 비우면 SMTP 미설정 — 그땐 이 값도 불필요)

idp_client_ids = {
  google = "REPLACE_WITH_GOOGLE_OAUTH_CLIENT_ID"
  kakao  = "REPLACE_WITH_KAKAO_REST_API_KEY"
  naver  = "REPLACE_WITH_NAVER_CLIENT_ID"
}

# idp_client_secrets 는 여기 두지 말 것(중요). tfvars 값은 -var/TF_VAR 보다 우선이라,
# placeholder 를 두면 SM 에서 주입한 실제 secret 을 덮어써 Google 이 invalid_client 로
# 거부한다(실제 발생함). apply 시 GCP Secret Manager 에서 -var 로 주입:
#   SM=$(gcloud secrets versions access latest --secret=cledyu-learn-idp-google-secret --project=cledyu-project)
#   terraform apply -var "idp_client_secrets={google=\"$SM\",kakao=\"unused\",naver=\"unused\"}"

